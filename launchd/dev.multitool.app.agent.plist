<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.multitool.app.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/Multitul.app/Contents/MacOS/Multitul</string>
        <string>--agent</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>__HOME__/Library/Logs/Multitul/agent.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/Multitul/agent.log</string>
</dict>
</plist>
